# Copy to .env and fill in only the values you need.
# Every variable below is optional: the defaults let the app start with no
# configuration at all. Secrets are placeholders - replace them locally and
# never commit the filled-in file.

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=4173
LOG_LEVEL=info

# --- Auth -----------------------------------------------------------------
# When set, the API requires "Authorization: Bearer <BANKAI_TOKEN>".
# Leave it empty to run without auth (development only - do not do this in
# production).
BANKAI_TOKEN=change-me-at-least-8-characters

# --- LLM providers --------------------------------------------------------
# Only needed for the features that call them. The app degrades gracefully
# when a provider key is missing.
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Storage --------------------------------------------------------------
# STORAGE_ROOT is the base for workspaces, logs and uploads.
# DB_PATH defaults to <STORAGE_ROOT>/storage/db/bankai.db when unset.
STORAGE_ROOT=./storage
DB_PATH=
