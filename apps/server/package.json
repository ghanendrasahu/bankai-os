{
    "name":  "@bankai/server",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "dev":  "tsx --env-file-if-exists=.env watch src/index.ts",
                    "start":  "node --env-file-if-exists=.env dist/index.js",
                    "test":  "vitest run"
                },
    "dependencies":  {
                         "@bankai/agent":  "0.1.0",
                         "@bankai/config":  "0.1.0",
                         "@bankai/contracts":  "0.1.0",
                         "@bankai/db":  "0.1.0",
                         "@bankai/tasks":  "0.1.0",
                         "@fastify/compress":  "^9.2.0",
                         "@fastify/cors":  "^11.0.0",
                         "@fastify/rate-limit":  "^11.2.0",
                         "@fastify/static":  "^10.1.3",
                         "fastify":  "^5.0.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "tsx":  "^4.19.0",
                            "typescript":  "^5.4.0",
                            "vitest":  "^3.2.4"
                        }
}
